{
  "_note": "Copy this file to ~/.llm-privacy-gate/config.json and edit it as needed, or edit it in place. API keys are always read from environment variables and must never be written into this file.",
  "endpoints": [
    {
      "name": "official",
      "kind": "official-direct",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "model": "gpt-4o-mini"
    },
    {
      "name": "relay",
      "kind": "relay (untrusted channel)",
      "base_url": "https://your-relay.example.com/v1",
      "api_key_env": "RELAY_API_KEY",
      "model": "gpt-4o-mini"
    }
  ],
  "local": {
    "kind": "local model (Ollama, optional — this skill does not require one)",
    "base_url": "http://localhost:11434/v1",
    "model": "llama3.1:8b"
  },
  "mask": {
    "enabled_types": ["ID_CARD", "PHONE", "TEL", "EMAIL", "BANKCARD", "IP", "AMOUNT"],
    "custom_words_file": "~/.llm-privacy-gate/custom_words.json"
  }
}
